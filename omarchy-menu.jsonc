{
  // Omarchy Browser Support Pack
  // Adds Vivaldi, Helium, Floorp, Waterfox, LibreWolf to Setup/Install/Remove menus.

  // Setup > Defaults > Browser — show only if installed
  "setup.default.browser.vivaldi": {"icon":"","label":"Vivaldi","when":"omarchy-cmd-present vivaldi-stable","checked":"[[ \"$(omarchy-default-browser)\" == \"vivaldi\" ]]","action":"omarchy-default-browser vivaldi"},
  "setup.default.browser.helium": {"icon":"󰀘","label":"Helium","when":"omarchy-cmd-present helium-browser","checked":"[[ \"$(omarchy-default-browser)\" == \"helium\" ]]","action":"omarchy-default-browser helium"},
  "setup.default.browser.floorp": {"icon":"󰈹","label":"Floorp","when":"omarchy-cmd-present floorp","checked":"[[ \"$(omarchy-default-browser)\" == \"floorp\" ]]","action":"omarchy-default-browser floorp"},
  "setup.default.browser.waterfox": {"icon":"󰈹","label":"Waterfox","when":"omarchy-cmd-present waterfox","checked":"[[ \"$(omarchy-default-browser)\" == \"waterfox\" ]]","action":"omarchy-default-browser waterfox"},
  "setup.default.browser.librewolf": {"icon":"󰈹","label":"LibreWolf","when":"omarchy-cmd-present librewolf","checked":"[[ \"$(omarchy-default-browser)\" == \"librewolf\" ]]","action":"omarchy-default-browser librewolf"},

  // Install > Browser — individual entries (hide if installed)
  "install.browser.vivaldi": {"icon":"","label":"Vivaldi","when":"! omarchy-pkg-present vivaldi","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-install-browser vivaldi'"},
  "install.browser.helium": {"icon":"󰀘","label":"Helium","when":"! omarchy-pkg-present helium-browser-bin","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-install-browser helium'"},
  "install.browser.floorp": {"icon":"󰈹","label":"Floorp","when":"! omarchy-pkg-present floorp-bin","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-install-browser floorp'"},
  "install.browser.waterfox": {"icon":"󰈹","label":"Waterfox","when":"! omarchy-pkg-present waterfox-bin","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-install-browser waterfox'"},
  "install.browser.librewolf": {"icon":"󰈹","label":"LibreWolf","when":"! omarchy-pkg-present librewolf-bin","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-install-browser librewolf'"},

  // Remove > Browser — individual entries (show only if installed)
  "remove.browser.vivaldi": {"icon":"","label":"Vivaldi","when":"omarchy-pkg-present vivaldi","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-remove-browser vivaldi'"},
  "remove.browser.helium": {"icon":"󰀘","label":"Helium","when":"omarchy-pkg-present helium-browser-bin","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-remove-browser helium'"},
  "remove.browser.floorp": {"icon":"󰈹","label":"Floorp","when":"omarchy-pkg-present floorp-bin","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-remove-browser floorp'"},
  "remove.browser.waterfox": {"icon":"󰈹","label":"Waterfox","when":"omarchy-pkg-present waterfox-bin","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-remove-browser waterfox'"},
  "remove.browser.librewolf": {"icon":"󰈹","label":"LibreWolf","when":"omarchy-pkg-present librewolf-bin","action":"omarchy-launch-floating-terminal-with-presentation 'omarchy-remove-browser librewolf'"}
}
