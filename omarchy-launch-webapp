#!/bin/bash

# omarchy:summary=Launch a URL as a web app in the default supported browser
# omarchy:args=<url>

browser=$(xdg-settings get default-web-browser)

browser_exec() {
  sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/$1 2>/dev/null | head -1
}

resolve_exec() {
  local exec
  exec=$(browser_exec "$1")
  [[ -n $exec ]] || exec=$(browser_exec "$2")
  printf '%s' "$exec"
}

case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | chromium* | helium*)
  exec setsid uwsm-app -- "$(resolve_exec "$browser" chromium.desktop)" --app="$1" "${@:2}"
  ;;
firefox* | zen* | floorp* | waterfox* | librewolf*)
  exec setsid uwsm-app -- "$(resolve_exec "$browser" firefox.desktop)" --new-window "$1" "${@:2}"
  ;;
*)
  exec setsid uwsm-app -- "$(resolve_exec chromium.desktop chromium.desktop)" --app="$1" "${@:2}"
  ;;
esac
